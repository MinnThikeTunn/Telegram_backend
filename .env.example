# Multi-Tenant Telegram Bot Backend Environment Configuration
# Comma-separated list of Telegram bot tokens (get from @BotFather)
BOT_TOKENS=TOKEN_1,TOKEN_2
# Public HTTPS URL for webhook (use ngrok for local development)
BASE_URL=https://your-ngrok-url.ngrok-free.app
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini model override
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
# Facebook Messenger webhook verification token
FB_VERIFY_TOKEN=your_facebook_verify_token_here
# Facebook Page access token used to send Messenger replies
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
# Stable Messenger bot/page identifier used by personas_config.json
MESSENGER_BOT_ID=your_facebook_page_id_here
MESSENGER_BOT_NAME=Messenger Bot
# Base URL for the Delivery Matrix API (defaults to self on localhost:8000)
DELIVERY_API_BASE=http://localhost:8000
# Cache TTL in seconds for delivery zone data (default: 300 = 5 minutes)
DELIVERY_CACHE_TTL_SECONDS=300
